# Cursor MCP Base Image
# 包含所有基础依赖，构建一次后复用

FROM node:20-slim

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    curl \
    git \
    jq \
    python3 \
    python3-pip \
    python3-venv \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# 安装 Rust (某些 Python 包依赖) - 这步最慢
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# 安装 uv (包含 uvx，用于运行 Python 包)
RUN pip install uv --break-system-packages

# 验证基础环境
RUN node --version && \
    python3 --version && \
    rustc --version && \
    uvx --version

# 标记为 base image
LABEL maintainer="pas-team"
LABEL description="Base image with Node.js, Python, Rust for Cursor MCP"

